DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated trusted origins, including the URL scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-with-your-production-domain

POSTGRES_DB=vocabio
POSTGRES_USER=vocabio
POSTGRES_PASSWORD=replace-with-a-local-password

DATABASE_URL=postgresql://vocabio:replace-with-a-local-password@127.0.0.1:5432/vocabio
DATABASE_CONN_MAX_AGE=0
DATABASE_CONNECT_TIMEOUT=5

# Application locale and time zone
DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=UTC

# Redirect HTTP requests to HTTPS.
# Keep False for local development and set True in production.
SECURE_SSL_REDIRECT=False
