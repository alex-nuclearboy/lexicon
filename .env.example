# Generate a key with:
# poetry run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Leave empty for local development.
# Production example: https://your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=vocabio
POSTGRES_USER=vocabio
POSTGRES_PASSWORD=replace-with-a-local-password

DATABASE_URL=postgresql://vocabio:replace-with-a-local-password@127.0.0.1:5432/vocabio
DATABASE_CONN_MAX_AGE=0
DATABASE_CONNECT_TIMEOUT=5

# Application locale and time zone
DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=UTC

# Redirect HTTP requests to HTTPS.
# Keep False for local development and set True in production.
SECURE_SSL_REDIRECT=False
